<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Reverse Proxy: forward all requests to Next.js on port 3000 -->
    <rewrite>
      <rules>
        <rule name="NextJS Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <!-- Skip rewrite for static files served directly by IIS (optional optimization) -->
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Allow upload slip images up to 10MB -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- Enable WebSocket proxy support -->
    <webSocket enabled="true" />

    <!-- Custom error pages - let Next.js handle errors -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
